<Window x:Class="ValidadorDecisaoWPF.CalculadoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValidadorDecisaoWPF"
        mc:Ignorable="d"
        Title="Exercício 2: Calculadora Switch" Height="380" Width="400">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Calculadora Aritmética" FontSize="18" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,15"/>

            <TextBlock Text="Primeiro Número:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtNum1" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center" Padding="5"/>

            <TextBlock Text="Operação:" FontWeight="SemiBold"/>
            <ComboBox x:Name="cmbOperacao" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center">
                <ComboBoxItem Content="+" IsSelected="True"/>
                <ComboBoxItem Content="-"/>
                <ComboBoxItem Content="*"/>
                <ComboBoxItem Content="/"/>
            </ComboBox>

            <TextBlock Text="Segundo Número:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtNum2" Height="30" Margin="0,5,0,15" VerticalContentAlignment="Center" Padding="5"/>

            <Button x:Name="btnCalcular" Content="Calcular" Height="35" Background="#003366" Foreground="White" FontWeight="Bold" Click="btnCalcular_Click"/>

            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="12">
                <TextBlock x:Name="lblResultado" Text="Aguardando operação..." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>

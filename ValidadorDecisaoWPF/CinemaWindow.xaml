<Window x:Class="ValidadorDecisaoWPF.CinemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValidadorDecisaoWPF"
        mc:Ignorable="d"
        Title="Exercício 3: Simulador Cinema" Height="350" Width="420"
        Background="#F4F6F9" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Bilheteira de Cinema" FontSize="18" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,15"/>

            <TextBlock Text="Selecione o Dia da Semana:" FontWeight="SemiBold"/>
            <ComboBox x:Name="cmbDiaSemana" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Segunda-feira" IsSelected="True"/>
                <ComboBoxItem Content="Terça-feira"/>
                <ComboBoxItem Content="Quarta-feira"/>
                <ComboBoxItem Content="Quinta-feira"/>
                <ComboBoxItem Content="Sexta-feira"/>
                <ComboBoxItem Content="Sábado"/>
                <ComboBoxItem Content="Domingo"/>
            </ComboBox>

            <TextBlock Text="Idade do Cliente:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtIdadeCinema" Height="30" Margin="0,5,0,15" VerticalContentAlignment="Center" Padding="5"/>

            <Button x:Name="btnCalcularBilhete" Content="Calcular Preço do Bilhete" Height="35" Background="#003366" Foreground="White" FontWeight="Bold" Click="btnCalcularBilhete_Click"/>

            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="12">
                <TextBlock x:Name="lblResultado" Text="Aguardando dados..." TextWrapping="Wrap" FontSize="13" Foreground="#333333"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
